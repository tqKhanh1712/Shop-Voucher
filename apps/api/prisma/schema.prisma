model ContentEntry {
  contentId    String        @id @default(dbgenerated("gen_random_uuid()")) @map("content_id") @db.Uuid
  type         ContentType   @map("type")
  slug         String        @unique @map("slug") @db.VarChar(150)
  title        String        @map("title") @db.VarChar(255)
  summary      String?       @map("summary") @db.Text
  body         String?       @map("body") @db.Text
  imageUrl     String?       @map("image_url") @db.Text
  linkUrl      String?       @map("link_url") @db.Text
  status       ContentStatus @default(DRAFT) @map("status")
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz
  startsAt     DateTime?     @map("starts_at") @db.Timestamptz
  endsAt       DateTime?     @map("ends_at") @db.Timestamptz
  createdById  String?       @map("created_by_id") @db.Uuid
  updatedById  String?       @map("updated_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  createdBy User? @relation("ContentEntryCreatedBy", fields: [createdById], references: [userId], onDelete: SetNull)
  updatedBy User? @relation("ContentEntryUpdatedBy", fields: [updatedById], references: [userId], onDelete: SetNull)

  @@index([type, status, displayOrder], map: "Content_Entries_type_status_order_idx")
  @@index([status, startsAt, endsAt], map: "Content_Entries_status_window_idx")
  @@map("Content_Entries")
}

model CartItem {
  cartItemId String   @id @default(dbgenerated("gen_random_uuid()")) @map("cart_item_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  quantity   Int      @map("quantity")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  customer User            @relation(fields: [customerId], references: [userId], onDelete: Cascade)
  campaign VoucherCampaign @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)

  @@unique([customerId, campaignId])
  @@index([campaignId], map: "Cart_Items_campaign_id_idx")
  @@map("Cart_Items")
}

model VoucherReview {
  reviewId   String   @id @default(dbgenerated("gen_random_uuid()")) @map("review_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  rating     Int      @map("rating")
  comment    String?  @map("comment") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  customer   User            @relation(fields: [customerId], references: [userId], onDelete: Cascade)
  campaign   VoucherCampaign @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  complaints Complaint[]

  @@unique([customerId, campaignId])
  @@index([campaignId, createdAt(sort: Desc)], map: "Voucher_Reviews_campaign_created_at_idx")
  @@map("Voucher_Reviews")
}

model Complaint {
  complaintId        String            @id @default(dbgenerated("gen_random_uuid()")) @map("complaint_id") @db.Uuid
  customerId         String            @map("customer_id") @db.Uuid
  partnerId          String?           @map("partner_id") @db.Uuid
  assignedAdminId    String?           @map("assigned_admin_id") @db.Uuid
  orderId            String?           @map("order_id") @db.Uuid
  orderItemId        String?           @map("order_item_id") @db.Uuid
  voucherCodeId      String?           @map("voucher_code_id") @db.Uuid
  campaignId         String?           @map("campaign_id") @db.Uuid
  reviewId           String?           @map("review_id") @db.Uuid
  type               ComplaintType     @map("type")
  priority           ComplaintPriority @default(NORMAL) @map("priority")
  subject            String            @map("subject") @db.VarChar(255)
  description        String            @map("description") @db.Text
  status             ComplaintStatus   @default(OPEN) @map("status")
  resolutionResponse String?           @map("resolution_response") @db.Text
  resolvedById       String?           @map("resolved_by_id") @db.Uuid
  partnerDueAt       DateTime?         @map("partner_due_at") @db.Timestamptz
  customerDueAt      DateTime?         @map("customer_due_at") @db.Timestamptz
  resolvedAt         DateTime?         @map("resolved_at") @db.Timestamptz
  closedAt           DateTime?         @map("closed_at") @db.Timestamptz
  version            Int               @default(1) @map("version")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  customer      User               @relation("ComplaintCustomer", fields: [customerId], references: [userId], onDelete: Restrict)
  partner       Partner?           @relation(fields: [partnerId], references: [partnerId], onDelete: SetNull)
  assignedAdmin User?              @relation("ComplaintAssignee", fields: [assignedAdminId], references: [userId], onDelete: SetNull)
  resolvedBy    User?              @relation("ComplaintResolver", fields: [resolvedById], references: [userId], onDelete: SetNull)
  order         Order?             @relation(fields: [orderId], references: [orderId], onDelete: SetNull)
  orderItem     OrderItem?         @relation(fields: [orderItemId], references: [itemId], onDelete: SetNull)
  voucherCode   VoucherCode?       @relation(fields: [voucherCodeId], references: [codeId], onDelete: SetNull)
  campaign      VoucherCampaign?   @relation(fields: [campaignId], references: [campaignId], onDelete: SetNull)
  review        VoucherReview?     @relation(fields: [reviewId], references: [reviewId], onDelete: SetNull)
  messages      ComplaintMessage[]
  events        ComplaintEvent[]

  @@index([customerId, createdAt(sort: Desc)], map: "Complaints_customer_created_at_idx")
  @@index([status, createdAt(sort: Desc)], map: "Complaints_status_created_at_idx")
  @@index([partnerId, status, updatedAt(sort: Desc)], map: "Complaints_partner_status_updated_idx")
  @@index([assignedAdminId, status, updatedAt(sort: Desc)], map: "Complaints_assignee_status_updated_idx")
  @@index([orderId], map: "Complaints_order_id_idx")
  @@index([orderItemId], map: "Complaints_order_item_id_idx")
  @@index([voucherCodeId], map: "Complaints_voucher_code_id_idx")
  @@index([campaignId], map: "Complaints_campaign_id_idx")
  @@map("Complaints")
}

model ComplaintMessage {
  messageId          String                     @id @default(dbgenerated("gen_random_uuid()")) @map("message_id") @db.Uuid
  complaintId        String                     @map("complaint_id") @db.Uuid
  senderId           String?                    @map("sender_id") @db.Uuid
  senderRoleSnapshot UserRole?                  @map("sender_role_snapshot")
  visibility         ComplaintMessageVisibility @default(ALL_PARTIES) @map("visibility")
  body               String                     @map("body") @db.Text
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  complaint Complaint @relation(fields: [complaintId], references: [complaintId], onDelete: Cascade)
  sender    User?     @relation("ComplaintMessageSender", fields: [senderId], references: [userId], onDelete: SetNull)

  @@index([complaintId, createdAt], map: "Complaint_Messages_complaint_created_idx")
  @@map("Complaint_Messages")
}

model ComplaintEvent {
  eventId           String           @id @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  complaintId       String           @map("complaint_id") @db.Uuid
  actorId           String?          @map("actor_id") @db.Uuid
  actorRoleSnapshot UserRole?        @map("actor_role_snapshot")
  eventType         String           @map("event_type") @db.VarChar(100)
  fromStatus        ComplaintStatus? @map("from_status")
  toStatus          ComplaintStatus? @map("to_status")
  metadata          Json?            @map("metadata") @db.JsonB
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  complaint Complaint @relation(fields: [complaintId], references: [complaintId], onDelete: Cascade)
  actor     User?     @relation("ComplaintEventActor", fields: [actorId], references: [userId], onDelete: SetNull)

  @@index([complaintId, createdAt], map: "Complaint_Events_complaint_created_idx")
  @@map("Complaint_Events")
}

model SearchSynonym {
  id          Int      @id @default(autoincrement())
  keyword     String   @map("keyword")
  expandTo    String   @map("expand_to")
  categoryTag String?  @map("category_tag")
  weight      Int      @default(1) @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([keyword], map: "idx_synonyms_keyword")
  @@index([categoryTag], map: "idx_synonyms_category")
  @@map("search_synonyms")
}

model SearchLog {
  id               Int      @id @default(autoincrement())
  queryRaw         String   @map("query_raw")
  queryExpanded    String[] @map("query_expanded")
  categoryIntent   String[] @map("category_intent")
  resultCount      Int      @default(0) @map("result_count")
  clickedProductId String?  @map("clicked_product_id") @db.Uuid
  sessionId        String?  @map("session_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([queryRaw], map: "idx_search_logs_query")
  @@index([resultCount], map: "idx_search_logs_empty")
  @@map("search_logs")
}

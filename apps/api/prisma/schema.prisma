  adminId            String   @map("admin_id") @db.Uuid
  adminNameSnapshot  String   @map("admin_name_snapshot") @db.Text
  adminEmailSnapshot String?  @map("admin_email_snapshot") @db.Text
  actionType         String   @map("action_type") @db.VarChar(100)

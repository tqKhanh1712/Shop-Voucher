generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

model User {
  userId                       String             @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  email                        String?            @unique @map("email") @db.VarChar(255)
  phone                        String?            @unique @map("phone") @db.VarChar(20)
  passwordHash                 String             @map("password_hash") @db.VarChar(255)
  fullName                     String?            @map("full_name") @db.VarChar(255)
  role                         UserRole           @map("role")
  partnerId                    String?            @map("partner_id") @db.Uuid
  branchId                     String?            @map("branch_id") @db.Uuid
  status                       UserStatus         @default(PENDING_VERIFICATION) @map("status")
  passwordResetTokenHash       String?            @map("password_reset_token_hash") @db.Char(64)
  passwordResetExpiresAt       DateTime?          @map("password_reset_expires_at") @db.Timestamptz(6)
  passwordChangedAt            DateTime?          @map("password_changed_at") @db.Timestamptz(6)
  createdAt                    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  accountVerificationCodeHash  String?            @map("account_verification_code_hash") @db.Char(64)
  accountVerificationExpiresAt DateTime?          @map("account_verification_expires_at") @db.Timestamptz(6)
  activityLogs                 ActivityLog[]      @relation("ActivityActor")
  auditLogs                    AuditLog[]
  authSessions                 AuthSession[]
  cartItems                    CartItem[]
  complaintEvents              ComplaintEvent[]   @relation("ComplaintEventActor")
  complaintMessages            ComplaintMessage[] @relation("ComplaintMessageSender")
  assignedComplaints           Complaint[]        @relation("ComplaintAssignee")
  complaints                   Complaint[]        @relation("ComplaintCustomer")
  resolvedCases                Complaint[]        @relation("ComplaintResolver")
  contentCreated               ContentEntry[]     @relation("ContentEntryCreatedBy")
  contentUpdated               ContentEntry[]     @relation("ContentEntryUpdatedBy")
  orders                       Order[]
  partnerProfile               Partner?           @relation("UserToPartnerProfile")
  branch                       Branch?            @relation(fields: [partnerId, branchId], references: [partnerId, branchId], onDelete: Restrict)
  partnerStaffOf               Partner?           @relation("PartnerToStaff", fields: [partnerId], references: [partnerId], onDelete: Restrict)
  voucherCodes                 VoucherCode[]
  reviews                      VoucherReview[]

  @@index([partnerId, branchId], map: "Users_partner_branch_idx")
  @@index([role, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([partnerId, role, createdAt(sort: Desc)], map: "Users_partner_role_created_at_idx")
  @@index([accountVerificationExpiresAt], map: "Users_account_verification_expires_idx", where: raw("(account_verification_code_hash IS NOT NULL)"))
  @@map("Users")
}

model AuthSession {
  sessionId         String    @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastActivityAt    DateTime  @map("last_activity_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, revokedAt], map: "Auth_Sessions_user_revoked_idx")
  @@index([idleExpiresAt], map: "Auth_Sessions_idle_expires_idx")
  @@index([absoluteExpiresAt], map: "Auth_Sessions_absolute_expires_idx")
  @@map("Auth_Sessions")
}

model Partner {
  partnerId      String                @id @map("partner_id") @db.Uuid
  companyName    String                @map("company_name") @db.VarChar(255)
  taxCode        String                @unique @map("tax_code") @db.VarChar(50)
  representative String?               @map("representative") @db.VarChar(255)
  approvalStatus PartnerApprovalStatus @default(PENDING) @map("approval_status")
  accountStatus  PartnerAccountStatus  @default(ACTIVE) @map("account_status")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  branches       Branch[]
  complaints     Complaint[]
  user           User                  @relation("UserToPartnerProfile", fields: [partnerId], references: [userId])
  staff          User[]                @relation("PartnerToStaff")
  campaigns      VoucherCampaign[]

  @@index([approvalStatus, accountStatus, createdAt(sort: Desc)], map: "Partners_approval_account_created_at_idx")
  @@index([accountStatus, createdAt(sort: Desc)], map: "Partners_account_created_at_idx")
  @@map("Partners")
}

model Branch {
  branchId         String            @id @default(dbgenerated("gen_random_uuid()")) @map("branch_id") @db.Uuid
  partnerId        String            @map("partner_id") @db.Uuid
  name             String            @map("name") @db.VarChar(255)
  address          String?           @map("address")
  sourceUrl        String?           @map("source_url")
  externalSource   String?           @map("external_source") @db.VarChar(100)
  externalId       String?           @map("external_id") @db.VarChar(255)
  importedAt       DateTime?         @map("imported_at") @db.Timestamptz(6)
  provinceCode     String?           @map("province_code") @db.Char(2)
  partner          Partner           @relation(fields: [partnerId], references: [partnerId])
  campaignBranches CampaignBranch[]
  staff            User[]
  voucherUsageLogs VoucherUsageLog[]

  @@unique([partnerId, branchId])
  @@unique([externalSource, externalId])
  @@index([provinceCode])
  @@index([partnerId, name], map: "Branches_partner_name_idx")
  @@map("Branches")
}

model VoucherCampaign {
  campaignId            String                   @id @default(dbgenerated("gen_random_uuid()")) @map("campaign_id") @db.Uuid
  partnerId             String                   @map("partner_id") @db.Uuid
  title                 String                   @map("title") @db.VarChar(255)
  description           String?                  @map("description")
  category              String?                  @map("category") @db.VarChar(100)
  originalPrice         Decimal                  @map("original_price") @db.Decimal(12, 2)
  salePrice             Decimal                  @map("sale_price") @db.Decimal(12, 2)
  saleStartTime         DateTime                 @map("sale_start_time") @db.Timestamptz(6)
  saleEndTime           DateTime                 @map("sale_end_time") @db.Timestamptz(6)
  usageStartTime        DateTime                 @map("usage_start_time") @db.Timestamptz(6)
  usageEndTime          DateTime                 @map("usage_end_time") @db.Timestamptz(6)
  capacity              Int                      @map("capacity")
  soldQuantity          Int                      @default(0) @map("sold_quantity")
  reservedStock         Int                      @default(0) @map("reserved_stock")
  status                VoucherStatus            @default(DRAFT) @map("status")
  isMultiUse            Boolean                  @default(false) @map("is_multi_use")
  maxUsesPerCode        Int?                     @map("max_uses_per_code")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  thumbnailUrl          String?                  @map("thumbnail_url")
  sourceUrl             String?                  @map("source_url")
  externalSource        String?                  @map("external_source") @db.VarChar(100)
  externalId            String?                  @map("external_id") @db.VarChar(255)
  importedAt            DateTime?                @map("imported_at") @db.Timestamptz(6)
  termsAndConditions    String?                  @map("terms_and_conditions")
  currency              String                   @default("VND") @map("currency") @db.Char(3)
  usageValidityDays     Int?                     @map("usage_validity_days")
  sourceContentHash     String?                  @map("source_content_hash") @db.Char(64)
  lastSeenAt            DateTime?                @map("last_seen_at") @db.Timestamptz(6)
  refundAllowed         Boolean                  @default(false) @map("refund_allowed")
  refundWindowHours     Int?                     @map("refund_window_hours")
  refundPolicy          String?                  @map("refund_policy")
  cancellationPolicy    String?                  @map("cancellation_policy")
  policyVersion         Int                      @default(1) @map("policy_version")
  searchVector          Unsupported("tsvector")? @map("search_vector")
  embedding             Unsupported("vector")?   @map("embedding")
  campaignBranches      CampaignBranch[]
  campaignBrands        CampaignBrand?
  campaignCategories    CampaignCategory?
  cartItems             CartItem[]
  complaints            Complaint[]
  inventoryReservations InventoryReservation[]
  orderItems            OrderItem[]
  partner               Partner                  @relation(fields: [partnerId], references: [partnerId])
  reviews               VoucherReview[]

  @@unique([partnerId, campaignId])
  @@unique([externalSource, externalId])
  @@index([partnerId, createdAt(sort: Desc)], map: "Voucher_Campaigns_partner_created_at_idx")
  @@index([status, createdAt(sort: Desc)])
  @@index([partnerId, status, createdAt(sort: Desc)], map: "Voucher_Campaigns_partner_status_created_at_idx")
  @@index([saleEndTime, saleStartTime, createdAt(sort: Desc)], map: "Voucher_Campaigns_active_sale_window_idx", where: raw("(status = 'APPROVED'::\"VoucherStatus\")"))
  @@index([saleEndTime, saleStartTime, createdAt(sort: Desc)], map: "Voucher_Campaigns_public_available_window_idx", where: raw("((status = 'APPROVED'::\"VoucherStatus\") AND (((capacity - sold_quantity) - reserved_stock) > 0))"))
  @@index([embedding], map: "voucher_campaign_embedding_hnsw_idx")
  @@map("Voucher_Campaigns")
}

model CatalogBrand {
  brandId        String          @id @default(dbgenerated("gen_random_uuid()")) @map("brand_id") @db.Uuid
  displayName    String          @map("display_name") @db.VarChar(255)
  logoUrl        String?         @map("logo_url")
  sourceUrl      String?         @map("source_url")
  externalSource String          @map("external_source") @db.VarChar(100)
  externalId     String          @map("external_id") @db.VarChar(255)
  importedAt     DateTime        @default(now()) @map("imported_at") @db.Timestamptz(6)
  lastSeenAt     DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  campaignBrands CampaignBrand[]

  @@unique([externalSource, externalId])
  @@index([displayName])
  @@map("Catalog_Brands")
}

model VoucherCategory {
  categoryId         String             @id @default(dbgenerated("gen_random_uuid()")) @map("category_id") @db.Uuid
  code               String             @unique @map("code") @db.VarChar(50)
  nameVi             String             @map("name_vi") @db.VarChar(100)
  parentId           String?            @map("parent_id") @db.Uuid
  externalSource     String?            @map("external_source") @db.VarChar(100)
  externalId         String?            @map("external_id") @db.VarChar(255)
  displayOrder       Int                @default(0) @map("display_order")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  campaignCategories CampaignCategory[]
  parent             VoucherCategory?   @relation("VoucherCategoryHierarchy", fields: [parentId], references: [categoryId], onDelete: Restrict)
  children           VoucherCategory[]  @relation("VoucherCategoryHierarchy")

  @@unique([externalSource, externalId])
  @@index([parentId, displayOrder], map: "Voucher_Categories_parent_order_idx")
  @@map("Voucher_Categories")
}

model CampaignBrand {
  campaignId String          @unique(map: "Campaign_Brands_one_primary_per_campaign_key", where: raw("(is_primary = true)")) @map("campaign_id") @db.Uuid
  brandId    String          @map("brand_id") @db.Uuid
  isPrimary  Boolean         @default(false) @map("is_primary")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  brand      CatalogBrand    @relation(fields: [brandId], references: [brandId])
  campaign   VoucherCampaign @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)

  @@id([campaignId, brandId])
  @@index([brandId, campaignId], map: "Campaign_Brands_brand_campaign_idx")
  @@map("Campaign_Brands")
}

model CampaignCategory {
  campaignId String          @unique(map: "Campaign_Categories_one_primary_per_campaign_key", where: raw("(is_primary = true)")) @map("campaign_id") @db.Uuid
  categoryId String          @map("category_id") @db.Uuid
  isPrimary  Boolean         @default(false) @map("is_primary")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  campaign   VoucherCampaign @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  category   VoucherCategory @relation(fields: [categoryId], references: [categoryId])

  @@id([campaignId, categoryId])
  @@index([categoryId, campaignId], map: "Campaign_Categories_category_campaign_idx")
  @@map("Campaign_Categories")
}

model CampaignBranch {
  partnerId  String          @map("partner_id") @db.Uuid
  campaignId String          @map("campaign_id") @db.Uuid
  branchId   String          @map("branch_id") @db.Uuid
  branch     Branch          @relation(fields: [partnerId, branchId], references: [partnerId, branchId])
  campaign   VoucherCampaign @relation(fields: [partnerId, campaignId], references: [partnerId, campaignId], onDelete: Cascade)

  @@id([campaignId, branchId])
  @@index([partnerId, campaignId], map: "Campaign_Branches_partner_campaign_idx")
  @@index([partnerId, branchId], map: "Campaign_Branches_partner_branch_idx")
  @@index([branchId, campaignId], map: "Campaign_Branches_branch_campaign_idx")
  @@map("Campaign_Branches")
}

model Order {
  orderId                 String                 @id @default(dbgenerated("gen_random_uuid()")) @map("order_id") @db.Uuid
  orderCode               String                 @unique @map("order_code") @db.VarChar(32)
  customerId              String                 @map("customer_id") @db.Uuid
  recipientNote           String?                @map("recipient_note")
  totalAmount             Decimal                @map("total_amount") @db.Decimal(12, 2)
  baseCurrency            String                 @default("VND") @map("base_currency") @db.Char(3)
  selectedPaymentProvider PaymentProviderType?   @map("selected_payment_provider")
  orderStatus             OrderStatus            @default(PENDING) @map("order_status")
  paymentStatus           PaymentStatus          @default(UNPAID) @map("payment_status")
  reservationExpiresAt    DateTime               @map("reservation_expires_at") @db.Timestamptz(6)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  isGift                  Boolean                @default(false) @map("is_gift")
  recipientEmail          String?                @map("recipient_email") @db.VarChar(255)
  complaints              Complaint[]
  inventoryReservations   InventoryReservation[]
  orderItems              OrderItem[]
  customer                User                   @relation(fields: [customerId], references: [userId])
  paymentTransactions     PaymentTransaction?

  @@index([customerId, createdAt(sort: Desc)], map: "Orders_customer_created_at_idx")
  @@index([createdAt(sort: Desc)])
  @@index([paymentStatus, createdAt(sort: Desc)])
  @@index([orderStatus, createdAt(sort: Desc)])
  @@map("Orders")
}

model OrderItem {
  itemId                     String          @id @default(dbgenerated("gen_random_uuid()")) @map("item_id") @db.Uuid
  orderId                    String          @map("order_id") @db.Uuid
  campaignId                 String          @map("campaign_id") @db.Uuid
  quantity                   Int             @map("quantity")
  unitPrice                  Decimal         @map("unit_price") @db.Decimal(12, 2)
  refundAllowedSnapshot      Boolean         @default(false) @map("refund_allowed_snapshot")
  refundWindowHoursSnapshot  Int?            @map("refund_window_hours_snapshot")
  refundPolicySnapshot       String?         @map("refund_policy_snapshot")
  cancellationPolicySnapshot String?         @map("cancellation_policy_snapshot")
  policyVersionSnapshot      Int             @default(1) @map("policy_version_snapshot")
  refundDeadlineAt           DateTime?       @map("refund_deadline_at") @db.Timestamptz(6)
  complaints                 Complaint[]
  campaign                   VoucherCampaign @relation(fields: [campaignId], references: [campaignId])
  order                      Order           @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  voucherCodes               VoucherCode[]

  @@unique([orderId, campaignId])
  @@index([campaignId])
  @@index([refundDeadlineAt], map: "Order_Items_refund_deadline_active_idx", where: raw("((refund_allowed_snapshot = true) AND (refund_deadline_at IS NOT NULL))"))
  @@map("Order_Items")
}

model InventoryReservation {
  reservationId String            @id @default(dbgenerated("gen_random_uuid()")) @map("reservation_id") @db.Uuid
  orderId       String            @map("order_id") @db.Uuid
  campaignId    String            @map("campaign_id") @db.Uuid
  quantity      Int               @map("quantity")
  status        ReservationStatus @default(ACTIVE) @map("status")
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign      VoucherCampaign   @relation(fields: [campaignId], references: [campaignId])
  order         Order             @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@unique([orderId, campaignId])
  @@index([campaignId])
  @@index([expiresAt], map: "Inventory_Reservations_active_expires_at_idx", where: raw("(status = 'ACTIVE'::\"ReservationStatus\")"))
  @@map("Inventory_Reservations")
}

model PaymentTransaction {
  paymentId             String                   @id @default(dbgenerated("gen_random_uuid()")) @map("payment_id") @db.Uuid
  orderId               String                   @unique(map: "Payment_Transactions_one_active_order_idx", where: raw("(status = ANY (ARRAY['CREATED'::\"PaymentTransactionStatus\", 'PENDING'::\"PaymentTransactionStatus\"]))")) @map("order_id") @db.Uuid
  provider              PaymentProviderType      @map("provider")
  attemptNo             Int                      @map("attempt_no")
  status                PaymentTransactionStatus @map("status")
  idempotencyKey        String                   @unique @map("idempotency_key") @db.VarChar(100)
  providerOrderId       String?                  @map("provider_order_id") @db.VarChar(255)
  providerTransactionId String?                  @map("provider_transaction_id") @db.VarChar(255)
  baseAmount            Decimal                  @map("base_amount") @db.Decimal(12, 2)
  requestAmountMinor    BigInt                   @map("request_amount_minor")
  requestCurrency       String                   @map("request_currency") @db.Char(3)
  exchangeRate          Decimal?                 @map("exchange_rate") @db.Decimal(18, 8)
  failureCode           String?                  @map("failure_code") @db.VarChar(100)
  failureMessage        String?                  @map("failure_message")
  expiresAt             DateTime?                @map("expires_at") @db.Timestamptz(6)
  paidAt                DateTime?                @map("paid_at") @db.Timestamptz(6)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  settledAmountMinor    BigInt?                  @map("settled_amount_minor")
  settledCurrency       String?                  @map("settled_currency") @db.Char(3)
  refunds               PaymentRefund[]
  order                 Order                    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  webhookEvents         PaymentWebhookEvent[]

  @@unique([orderId, attemptNo])
  @@unique([provider, providerOrderId], map: "Payment_Transactions_provider_order_id_key", where: raw("(provider_order_id IS NOT NULL)"))
  @@unique([provider, providerTransactionId], map: "Payment_Transactions_provider_transaction_id_key", where: raw("(provider_transaction_id IS NOT NULL)"))
  @@map("Payment_Transactions")
}

model PaymentWebhookEvent {
  webhookEventId   String                         @id @default(dbgenerated("gen_random_uuid()")) @map("webhook_event_id") @db.Uuid
  provider         PaymentProviderType            @map("provider")
  providerEventId  String                         @map("provider_event_id") @db.VarChar(255)
  eventType        String                         @map("event_type") @db.VarChar(100)
  signatureValid   Boolean                        @map("signature_valid")
  payloadHash      String                         @map("payload_hash") @db.Char(64)
  processingStatus PaymentWebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  paymentId        String?                        @map("payment_id") @db.Uuid
  receivedAt       DateTime                       @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime?                      @map("processed_at") @db.Timestamptz(6)
  processingError  String?                        @map("processing_error")
  payment          PaymentTransaction?            @relation(fields: [paymentId], references: [paymentId])

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("Payment_Webhook_Events")
}

model PaymentRefund {
  refundId         String              @id @default(dbgenerated("gen_random_uuid()")) @map("refund_id") @db.Uuid
  paymentId        String              @map("payment_id") @db.Uuid
  providerRefundId String?             @map("provider_refund_id") @db.VarChar(255)
  amountMinor      BigInt              @map("amount_minor")
  currency         String              @map("currency") @db.Char(3)
  status           PaymentRefundStatus @default(PENDING) @map("status")
  idempotencyKey   String              @unique @map("idempotency_key") @db.VarChar(100)
  reason           String              @map("reason") @db.VarChar(255)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  payment          PaymentTransaction  @relation(fields: [paymentId], references: [paymentId])

  @@index([paymentId])
  @@map("Payment_Refunds")
}

model VoucherCode {
  codeId     String            @id @default(dbgenerated("gen_random_uuid()")) @map("code_id") @db.Uuid
  itemId     String            @map("item_id") @db.Uuid
  uniqueCode String            @unique @map("unique_code") @db.VarChar(64)
  customerId String            @map("customer_id") @db.Uuid
  status     VoucherCodeStatus @default(AVAILABLE) @map("status")
  issuedAt   DateTime          @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt  DateTime?         @map("expires_at") @db.Timestamptz(6)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  complaints Complaint[]
  customer   User              @relation(fields: [customerId], references: [userId])
  orderItem  OrderItem         @relation(fields: [itemId], references: [itemId])
  usageLogs  VoucherUsageLog[]

  @@index([customerId, issuedAt(sort: Desc)], map: "Voucher_Codes_customer_issued_at_idx")
  @@index([status, expiresAt])
  @@index([itemId, status], map: "Voucher_Codes_item_status_idx")
  @@map("Voucher_Codes")
}

model VoucherUsageLog {
  usageId     String      @id @default(dbgenerated("gen_random_uuid()")) @map("usage_id") @db.Uuid
  codeId      String      @map("code_id") @db.Uuid
  branchId    String      @map("branch_id") @db.Uuid
  usedAt      DateTime    @default(now()) @map("used_at") @db.Timestamptz(6)
  branch      Branch      @relation(fields: [branchId], references: [branchId])
  voucherCode VoucherCode @relation(fields: [codeId], references: [codeId])

  @@index([codeId, usedAt(sort: Desc)], map: "Voucher_Usage_Log_code_used_at_idx")
  @@index([branchId, usedAt(sort: Desc)], map: "Voucher_Usage_Log_branch_used_at_idx")
  @@map("Voucher_Usage_Log")
}

model AuditLog {
  logId              String   @id @default(dbgenerated("gen_random_uuid()")) @map("log_id") @db.Uuid
  adminId            String   @map("admin_id") @db.Uuid
  adminNameSnapshot  String   @map("admin_name_snapshot")
  adminEmailSnapshot String?  @map("admin_email_snapshot")
  actionType         String   @map("action_type") @db.VarChar(100)
  targetEntity       String   @map("target_entity") @db.VarChar(100)
  targetId           String?  @map("target_id") @db.Uuid
  timestamp          DateTime @default(now()) @map("timestamp") @db.Timestamptz(6)
  admin              User     @relation(fields: [adminId], references: [userId])

  @@index([adminId])
  @@index([timestamp(sort: Desc)])
  @@map("Audit_Logs")
}

model ActivityLog {
  activityId         String           @id @default(dbgenerated("gen_random_uuid()")) @map("activity_id") @db.Uuid
  actorUserId        String?          @map("actor_user_id") @db.Uuid
  actorRoleSnapshot  UserRole?        @map("actor_role_snapshot")
  category           ActivityCategory @map("category")
  actionType         String           @map("action_type") @db.VarChar(100)
  targetEntity       String           @map("target_entity") @db.VarChar(100)
  targetId           String?          @map("target_id") @db.VarChar(100)
  metadata           Json?            @map("metadata")
  ipAddress          String?          @map("ip_address") @db.VarChar(64)
  userAgent          String?          @map("user_agent") @db.VarChar(512)
  occurredAt         DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorNameSnapshot  String?          @map("actor_name_snapshot") @db.VarChar(255)
  actorEmailSnapshot String?          @map("actor_email_snapshot") @db.VarChar(255)
  actor              User?            @relation("ActivityActor", fields: [actorUserId], references: [userId])

  @@index([actorUserId, occurredAt(sort: Desc)], map: "Activity_Logs_actor_occurred_at_idx")
  @@index([category, occurredAt(sort: Desc)])
  @@index([actionType, occurredAt(sort: Desc)], map: "Activity_Logs_action_occurred_at_idx")
  @@index([targetEntity, targetId, occurredAt(sort: Desc)], map: "Activity_Logs_target_occurred_at_idx")
  @@map("Activity_Logs")
}

model ContentEntry {
  contentId    String        @id @default(dbgenerated("gen_random_uuid()")) @map("content_id") @db.Uuid
  type         ContentType   @map("type")
  slug         String        @unique @map("slug") @db.VarChar(150)
  title        String        @map("title") @db.VarChar(255)
  summary      String?       @map("summary")
  body         String?       @map("body")
  imageUrl     String?       @map("image_url")
  linkUrl      String?       @map("link_url")
  status       ContentStatus @default(DRAFT) @map("status")
  displayOrder Int           @default(0) @map("display_order")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  startsAt     DateTime?     @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime?     @map("ends_at") @db.Timestamptz(6)
  createdById  String?       @map("created_by_id") @db.Uuid
  updatedById  String?       @map("updated_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    User?         @relation("ContentEntryCreatedBy", fields: [createdById], references: [userId])
  updatedBy    User?         @relation("ContentEntryUpdatedBy", fields: [updatedById], references: [userId])

  @@index([type, status, displayOrder], map: "Content_Entries_type_status_order_idx")
  @@index([status, startsAt, endsAt], map: "Content_Entries_status_window_idx")
  @@map("Content_Entries")
}

model CartItem {
  cartItemId String          @id @default(dbgenerated("gen_random_uuid()")) @map("cart_item_id") @db.Uuid
  customerId String          @map("customer_id") @db.Uuid
  campaignId String          @map("campaign_id") @db.Uuid
  quantity   Int             @map("quantity")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign   VoucherCampaign @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  customer   User            @relation(fields: [customerId], references: [userId], onDelete: Cascade)

  @@unique([customerId, campaignId])
  @@index([campaignId])
  @@map("Cart_Items")
}

model VoucherReview {
  reviewId   String          @id @default(dbgenerated("gen_random_uuid()")) @map("review_id") @db.Uuid
  customerId String          @map("customer_id") @db.Uuid
  campaignId String          @map("campaign_id") @db.Uuid
  rating     Int             @map("rating")
  comment    String?         @map("comment")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  complaints Complaint[]
  campaign   VoucherCampaign @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  customer   User            @relation(fields: [customerId], references: [userId], onDelete: Cascade)

  @@unique([customerId, campaignId])
  @@index([campaignId, createdAt(sort: Desc)], map: "Voucher_Reviews_campaign_created_at_idx")
  @@map("Voucher_Reviews")
}

model Complaint {
  complaintId        String             @id @default(dbgenerated("gen_random_uuid()")) @map("complaint_id") @db.Uuid
  customerId         String             @map("customer_id") @db.Uuid
  orderId            String?            @map("order_id") @db.Uuid
  campaignId         String?            @map("campaign_id") @db.Uuid
  reviewId           String?            @map("review_id") @db.Uuid
  type               ComplaintType      @map("type")
  subject            String             @map("subject") @db.VarChar(255)
  description        String             @map("description")
  status             ComplaintStatus    @default(OPEN) @map("status")
  resolutionResponse String?            @map("resolution_response")
  resolvedById       String?            @map("resolved_by_id") @db.Uuid
  resolvedAt         DateTime?          @map("resolved_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  partnerId          String?            @map("partner_id") @db.Uuid
  assignedAdminId    String?            @map("assigned_admin_id") @db.Uuid
  orderItemId        String?            @map("order_item_id") @db.Uuid
  voucherCodeId      String?            @map("voucher_code_id") @db.Uuid
  priority           ComplaintPriority  @default(NORMAL) @map("priority")
  partnerDueAt       DateTime?          @map("partner_due_at") @db.Timestamptz(6)
  customerDueAt      DateTime?          @map("customer_due_at") @db.Timestamptz(6)
  closedAt           DateTime?          @map("closed_at") @db.Timestamptz(6)
  version            Int                @default(1) @map("version")
  events             ComplaintEvent[]
  messages           ComplaintMessage[]
  assignedAdmin      User?              @relation("ComplaintAssignee", fields: [assignedAdminId], references: [userId])
  campaign           VoucherCampaign?   @relation(fields: [campaignId], references: [campaignId])
  customer           User               @relation("ComplaintCustomer", fields: [customerId], references: [userId])
  order              Order?             @relation(fields: [orderId], references: [orderId])
  orderItem          OrderItem?         @relation(fields: [orderItemId], references: [itemId])
  partner            Partner?           @relation(fields: [partnerId], references: [partnerId])
  resolvedBy         User?              @relation("ComplaintResolver", fields: [resolvedById], references: [userId])
  review             VoucherReview?     @relation(fields: [reviewId], references: [reviewId])
  voucherCode        VoucherCode?       @relation(fields: [voucherCodeId], references: [codeId])

  @@index([customerId, createdAt(sort: Desc)], map: "Complaints_customer_created_at_idx")
  @@index([status, createdAt(sort: Desc)])
  @@index([partnerId, status, updatedAt(sort: Desc)], map: "Complaints_partner_status_updated_idx")
  @@index([assignedAdminId, status, updatedAt(sort: Desc)], map: "Complaints_assignee_status_updated_idx")
  @@index([orderId])
  @@index([orderItemId])
  @@index([voucherCodeId])
  @@index([campaignId])
  @@map("Complaints")
}

model ComplaintMessage {
  messageId          String                     @id @default(dbgenerated("gen_random_uuid()")) @map("message_id") @db.Uuid
  complaintId        String                     @map("complaint_id") @db.Uuid
  senderId           String?                    @map("sender_id") @db.Uuid
  senderRoleSnapshot UserRole?                  @map("sender_role_snapshot")
  visibility         ComplaintMessageVisibility @default(ALL_PARTIES) @map("visibility")
  body               String                     @map("body")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  complaint          Complaint                  @relation(fields: [complaintId], references: [complaintId], onDelete: Cascade)
  sender             User?                      @relation("ComplaintMessageSender", fields: [senderId], references: [userId])

  @@index([complaintId, createdAt], map: "Complaint_Messages_complaint_created_idx")
  @@map("Complaint_Messages")
}

model ComplaintEvent {
  eventId           String           @id @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  complaintId       String           @map("complaint_id") @db.Uuid
  actorId           String?          @map("actor_id") @db.Uuid
  actorRoleSnapshot UserRole?        @map("actor_role_snapshot")
  eventType         String           @map("event_type") @db.VarChar(100)
  fromStatus        ComplaintStatus? @map("from_status")
  toStatus          ComplaintStatus? @map("to_status")
  metadata          Json?            @map("metadata")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  actor             User?            @relation("ComplaintEventActor", fields: [actorId], references: [userId])
  complaint         Complaint        @relation(fields: [complaintId], references: [complaintId], onDelete: Cascade)

  @@index([complaintId, createdAt], map: "Complaint_Events_complaint_created_idx")
  @@map("Complaint_Events")
}

model SearchSynonym {
  id          Int      @id @default(autoincrement())
  keyword     String   @map("keyword")
  expandTo    String   @map("expand_to")
  categoryTag String?  @map("category_tag")
  weight      Int      @default(1) @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([keyword], map: "idx_synonyms_keyword")
  @@index([categoryTag], map: "idx_synonyms_category")
  @@map("search_synonyms")
}

model SearchLog {
  id               Int      @id @default(autoincrement())
  queryRaw         String   @map("query_raw")
  queryExpanded    String[] @map("query_expanded")
  categoryIntent   String[] @map("category_intent")
  resultCount      Int      @default(0) @map("result_count")
  clickedProductId String?  @map("clicked_product_id") @db.Uuid
  sessionId        String?  @map("session_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([queryRaw], map: "idx_search_logs_query")
  @@index([resultCount], map: "idx_search_logs_empty")
  @@map("search_logs")
}


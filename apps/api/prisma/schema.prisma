  targetId           String?  @map("target_id") @db.Uuid
  timestamp          DateTime @default(now()) @map("timestamp") @db.Timestamptz

  // Relations
  admin User @relation(fields: [adminId], references: [userId], onDelete: Restrict)

  @@index([adminId], map: "Audit_Logs_admin_id_idx")
  @@index([timestamp(sort: Desc)], map: "Audit_Logs_timestamp_idx")
